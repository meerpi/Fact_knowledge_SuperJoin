# ==============================================================================
# Environment Configuration for Fact Knowledge Layer
# ==============================================================================

# Gemini API Key (Required for fact extraction)
# Obtain a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Voyage AI API Key (Optional — for voyage-finance-2 semantic embeddings)
# If omitted, the system gracefully falls back to fuzzy string alignment
VOYAGE_API_KEY=your_voyage_api_key_here
